{
  "name": "myterm",
  "version": "0.1.0",
  "description": "Agent Terminal for macOS",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "MYTERM_TEST_HOOKS=1 electron-vite build --outDir out-e2e && vitest run --config vitest.e2e.config.ts",
    "package": "npm run build && node scripts/check-release.mjs --dir out && electron-builder --mac --dir",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.sanakulov.myterm",
    "productName": "Agent Terminal",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ]
  }
}
